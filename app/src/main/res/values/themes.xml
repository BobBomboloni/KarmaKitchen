<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The launch window is logo maroon, because the startup animation starts on maroon.
         MainActivity then sets the window background to the light or dark app colour (whichever
         is saved). The screens themselves follow the palettes in ui/theme. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_maroon</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
