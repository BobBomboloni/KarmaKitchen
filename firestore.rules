rules_version = '2';

// Security rules for KarmaKitchen. Paste this file into Firebase console > Firestore Database >
// Rules and press Publish (or deploy it with the Firebase CLI).
//
// The rules are what keep coins honest: a donor can post a donation, but only the verified NGO
// that accepted it can mark it received, and a donor's balance is the coins on their received
// donations minus what they have spent.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // NGOs are verified by hand: set `verified` to true on ngos/{uid} in the console.
    function isVerifiedNgo() {
      return signedIn()
        && exists(/databases/$(database)/documents/ngos/$(request.auth.uid))
        && get(/databases/$(database)/documents/ngos/$(request.auth.uid)).data.verified == true;
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.role in ['donor', 'ngo']
        && request.resource.data.coinsSpent == 0;
      // The role never changes, and coins spent can only go up.
      allow update: if isMe(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.coinsSpent is int
        && request.resource.data.coinsSpent >= resource.data.coinsSpent;
      allow delete: if false;
    }

    match /ngos/{ngoId} {
      allow read: if signedIn();
      allow create: if isMe(ngoId) && request.resource.data.verified == false;
      allow update: if isMe(ngoId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']);
      allow delete: if false;
    }

    match /donations/{donationId} {
      // Donors see their own; verified NGOs see open offers and the ones they accepted.
      allow read: if signedIn() && (
        resource.data.donorId == request.auth.uid
        || resource.data.ngoId == request.auth.uid
        || (resource.data.status == 'offered' && isVerifiedNgo())
      );

      allow create: if signedIn()
        && myRole() == 'donor'
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'offered'
        && request.resource.data.ngoId == null
        && request.resource.data.donorAcknowledged == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.servings is int
        // Coins follow FoodRules.kt: at most 50 counted servings at 50 coins each.
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 2500;

      allow update: if signedIn() && (
        // A verified NGO accepts an open offer.
        (resource.data.status == 'offered'
          && request.resource.data.status == 'on_the_way'
          && request.resource.data.ngoId == request.auth.uid
          && isVerifiedNgo()
          && changesOnly(['status', 'ngoId', 'ngoName', 'volunteer', 'etaMinutes', 'acceptedAt', 'updatedAt']))
        // The NGO that accepted it records that the food arrived. This unlocks the donor's coins.
        || (resource.data.status == 'on_the_way'
          && request.resource.data.status == 'received'
          && resource.data.ngoId == request.auth.uid
          && changesOnly(['status', 'intake', 'receivedAt', 'updatedAt']))
        // The donor dismisses the "Delivered" card.
        || (resource.data.donorId == request.auth.uid
          && changesOnly(['donorAcknowledged']))
      );

      allow delete: if false;
    }
  }
}
